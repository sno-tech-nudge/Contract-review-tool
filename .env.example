# SQLite file for local development. For hosted use, switch prisma/schema.prisma
# provider to "postgresql" and point this at the Postgres instance.
DATABASE_URL="file:./dev.db"

# Where uploaded contracts are stored on disk (relative to the project root)
STORAGE_DIR="storage"

# Optional. When set, reviews add a Claude-written summary, key terms and extra
# risks on top of the rule-based checks. Without it, every check still runs.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
