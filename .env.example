# ── Database (Postgres) ─────────────────────────────────────────────
# Runtime connection. On Vercel use the pooled URL from your Postgres
# provider (Neon: DATABASE_URL, Supabase: the port 6543 pooler URL with
# ?pgbouncer=true). Locally, run `npm run db:local` and paste its TCP URL
# here, adding &connection_limit=1.
DATABASE_URL=""
# Direct (non-pooled) connection, used to apply migrations during the build.
# Neon: DATABASE_URL_UNPOOLED. Supabase: the port 5432 URL. Locally: same as above.
DIRECT_URL=""

# ── File storage ───────────────────────────────────────────────────
# Set automatically when you connect a Vercel Blob store to the project.
# Leave empty locally to store files under STORAGE_DIR on disk.
BLOB_READ_WRITE_TOKEN=""
STORAGE_DIR="storage"

# ── Sign-in ────────────────────────────────────────────────────────
# Shared team password. When set, every page needs it; when empty (local
# development) the app is open. Always set this on a hosted deployment.
APP_PASSWORD=""
# Optional extra secret mixed into the session cookie. Changing it (or the
# password) signs everyone out.
AUTH_SECRET=""

# ── AI review (optional) ───────────────────────────────────────────
# When set, Claude adds a summary, key terms and extra risks to each review.
# Without it, every rule-based check still runs.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
