// Postgres everywhere. On Vercel, DATABASE_URL is the pooled connection used
// at runtime and DIRECT_URL the direct one used for migrations. Locally,
// `npx prisma dev` provides a Postgres and both point at it.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// One uploaded file. REPOSITORY documents form the knowledge base that reviews
// are measured against; REVIEW documents are contracts people upload to be checked.
model Document {
  id           String   @id @default(cuid())
  kind         String // REPOSITORY | REVIEW
  title        String
  fileName     String
  mimeType     String
  size         Int
  storageKey   String
  contractType String // see CONTRACT_TYPES in src/lib/contracts/types.ts
  counterparty String   @default("")
  tags         String   @default("") // semicolon-joined
  isTemplate   Boolean  @default(false) // approved boilerplate, weighted higher when comparing
  notes        String   @default("")
  pageCount    Int      @default(0)
  textSource   String   @default("pdf") // pdf | ocr (scanned pages recognised in the browser)
  text         String   @default("")
  pagesJson    String   @default("[]") // string[] of per-page text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clauses Clause[]
  reviews Review[]

  @@index([kind, contractType])
}

model Clause {
  id         String @id @default(cuid())
  documentId String
  position   Int
  heading    String
  text       String
  clauseType String
  page       Int    @default(1)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([clauseType])
  @@index([documentId])
}

model Review {
  id           String   @id @default(cuid())
  documentId   String
  status       String   @default("COMPLETE") // PROCESSING | COMPLETE | FAILED
  stage        String   @default("") // what a review in progress is doing now
  error        String   @default("") // why it failed, in words for the reviewer
  contractType String
  riskScore    Int      @default(0) // 0 (clean) to 100 (high risk)
  resultJson   String   @default("{}") // ReviewResult, see src/lib/review/types.ts
  createdAt    DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  feedback FindingFeedback[]
  missed   MissedIssue[]

  @@index([createdAt])
}

// Organisation-specific checks, configured from the rules page.
model BusinessRule {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  kind        String // REQUIRE_PHRASE | FORBID_PHRASE | REQUIRE_CLAUSE | MAX_DAYS | MAX_AMOUNT
  pattern     String   @default("") // phrases separated by ";" or a clause type
  threshold   Float?
  severity    String   @default("medium")
  appliesTo   String   @default("") // semicolon-joined contract types, empty = all
  guidance    String   @default("")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Lets people switch individual built-in legal rules off.
model LegalRuleSetting {
  ruleId  String  @id
  enabled Boolean @default(true)
}

// Small key/value store for one-off app state (e.g. starter rules seeded).
model Meta {
  key   String @id
  value String
}

// ── Learning ────────────────────────────────────────────────────────────
// The tool improves from what reviewers tell it. See src/lib/learning/.

// "Useful" / "not relevant" on one finding of one review. ruleKey identifies
// the check across reviews (e.g. legal:fcra-account, bp:missing:indemnity).
model FindingFeedback {
  id           String   @id @default(cuid())
  reviewId     String? // kept (as null) if the review is deleted, so the lesson survives
  findingId    String
  ruleKey      String
  check        String
  title        String
  contractType String
  verdict      String // useful | not_relevant
  reason       String   @default("")
  userId       String? // who voted; null for votes from before sign-in by person
  userName     String   @default("")
  weight       Int      @default(1) // a legal reviewer's vote counts double
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  review Review? @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  @@unique([reviewId, findingId])
  @@index([ruleKey, contractType])
}

// Something a reviewer found that the checks did not.
model MissedIssue {
  id           String   @id @default(cuid())
  reviewId     String?
  contractType String
  quote        String
  note         String
  severity     String   @default("medium")
  page         Int?
  status       String   @default("open") // open | rule_created | dismissed
  userId       String?
  userName     String   @default("")
  createdAt    DateTime @default(now())

  review Review? @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  @@index([status])
}

// A person's decision to keep a rule on (or off) regardless of feedback.
// contractType "*" applies to every type.
model RuleOverride {
  ruleKey      String
  contractType String
  mode         String // on | off
  updatedAt    DateTime @updatedAt

  @@id([ruleKey, contractType])
}

// Confirmed labels that train the classifiers: a contract type a person set,
// or a clause type a person corrected.
model TrainingExample {
  id        String   @id @default(cuid())
  kind      String // contract_type | clause_type
  label     String
  text      String
  sourceId  String   @default("") // document or clause it came from, so re-labelling replaces it
  createdAt DateTime @default(now())

  @@unique([kind, sourceId])
  @@index([kind])
}

// What changed and why, shown on the learning page.
model LearningEvent {
  id        String   @id @default(cuid())
  kind      String
  summary   String
  userName  String   @default("") // who caused it, when a person did
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Standard clauses imported from the team's clause library (PDF exports with a
// standard version and alternatives per topic). Kept in the database, not the
// code, so the team can add to it and correct how each version is read.
model LibraryClause {
  id           String   @id @default(cuid())
  key          String   @unique // topic + label, so re-importing a file updates instead of duplicating
  topic        String
  clauseType   String
  variant      String // standard | alternative
  label        String // the version's name, which says where or when it applies
  title        String   @default("")
  text         String
  validFor     String   @default("") // contract types it is meant for, ";"-joined; empty means any
  jurisdiction String   @default("") // "us" when it rests on US law
  source       String   @default("") // file it was imported from
  position     Int      @default(0)
  edited       Boolean  @default(false) // a person changed its type or contract types; imports keep their choice
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([clauseType])
}

// People who sign in. Passwords are scrypt hashes; a new person sets theirs
// through a one-time setup link an admin shares, so no one else ever knows it.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         String    @default("member") // admin | legal | member
  passwordHash String    @default("")
  setupHash    String    @default("") // sha256 of the one-time setup link token
  setupExpires DateTime?
  active       Boolean   @default(true)
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
}
